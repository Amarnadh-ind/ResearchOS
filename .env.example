# ============================================================
# ResearchOS Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_API_KEY=your_gemma_api_key_here
MANUS_API_KEY=your_manus_api_key_here
MANUS_BASE_URL=https://api.manus.ai/v1

# Nemotron 3 Ultra (NVIDIA) - fallback when Gemini is out of tokens
NEMOTRON_API_KEY=your_nemotron_api_key_here
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

LLM_PROVIDER=auto

# Web Search (optional - falls back to DuckDuckGo)
TAVILY_API_KEY=

# Firecrawl
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=researchos
POSTGRES_PASSWORD=researchos_secret_2024
POSTGRES_DB=researchos

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=researchos_neo4j_2024

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
LOG_LEVEL=info

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000